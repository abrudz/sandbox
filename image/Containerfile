# syntax=docker/dockerfile:1

FROM docker.io/library/golang:1.24-bookworm AS runner-api
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /out/runner-api ./cmd/runner-api

FROM docker.io/dyalog/dyalog:latest
COPY --from=runner-api /out/runner-api /usr/local/bin/runner-api
ENTRYPOINT ["/usr/local/bin/runner-api"]
