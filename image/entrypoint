#!/usr/bin/env bash
#
# Entry point of the sandbox image. Runs as root in a container with
# CAP_SYS_ADMIN, AppArmor unconfined and a private cgroup namespace, where
# /sys/fs/cgroup is the container's own cgroup (see README.md for the
# docker run flags).
#
# nsjail puts each run in a child cgroup with cpu, memory and pids limits,
# so those controllers must be enabled for child cgroups. cgroup v2 refuses
# that while processes sit in the parent (the "no internal processes"
# rule), so every process in the container's cgroup first moves to the
# leaf cgroup "init".

set -euo pipefail

cgroup=/sys/fs/cgroup

# Docker mounts the cgroup filesystem read-only in a container that is not
# privileged; nsjail creates a cgroup for every run.
mount -o remount,rw "$cgroup"

mkdir -p "$cgroup/init"
# cgroup.procs shrinks as processes leave it, and reading it while moving
# them skips entries, so the whole list is read first. A process that
# exits before it is moved is skipped.
pids=$(< "$cgroup/cgroup.procs")
for pid in $pids; do
  echo "$pid" > "$cgroup/init/cgroup.procs" 2> /dev/null || true
done
echo "+cpu +memory +pids" > "$cgroup/cgroup.subtree_control"

exec /usr/local/bin/runner-api "$@"
