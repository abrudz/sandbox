# SITE_ADDRESS comes from the compose environment. For a domain such as
# dyalog.run, whose DNS points to this host, Caddy obtains and renews the
# certificate and redirects HTTP to HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip
	# runner-api's largest valid body with its default limits (bodyLimit in
	# internal/api/limits.go). A larger one is refused from its
	# Content-Length, before any of it is read.
	request_body {
		max_size 484KiB
	}
	# runner-api's socket, in the volume shared with the sandbox container,
	# which has no network.
	reverse_proxy unix//run/sandbox/runner-api.sock
}
